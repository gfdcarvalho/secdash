Authorization: Bearer {{token}}

### Get the list of Teams of the User Logged in
GET http://localhost:8080/teams
Authorization: Bearer {{token}}

### get team information
GET http://localhost:8080/teams/1
Authorization: Bearer {{token}}

### Delete a Team
DELETE http://localhost:8080/teams/2
Authorization: Bearer {{token}}

### Add user to team
POST http://localhost:8080/teams/1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "userId": 2
}

### remove user from team
DELETE http://localhost:8080/teams/1/users/2
Authorization: Bearer {{token}}

### promote user to team leader
PATCH http://localhost:8080/teams/1/users/2
Authorization: Bearer {{token}}

### add repository to team
POST http://localhost:8080/teams/1/repository
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "repositoryId": 1
}

### remove repository from a team
DELETE http://localhost:8080/teams/1/repository/1
Authorization: Bearer {{token}}
